                                                <div class="assignment-toolbar"><div><strong><i class="fa fa-briefcase" aria-hidden="true"></i> Assignment History</strong><small>All recorded periods for the selected employee</small></div><div><label for="assignment-search">Search history</label><input id="assignment-search" type="search" class="form-control input-sm" ng-model="assignmentSearch" placeholder="Name, position, department or source"></div></div>
                                                <div class="alert alert-info" ng-if="!assignmentEmployee">Select an employee to view assignment history.</div>
                                                <div class="text-center" ng-if="assignmentLoading" role="status"><i class="fa fa-spinner fa-spin"></i> Loading assignment history...</div>
                                                <div class="alert alert-danger" ng-if="assignmentError" role="alert">{{assignmentError}} <button type="button" class="btn btn-default btn-xs" ng-click="loadAssignments()">Retry</button></div>
                                                <div ng-if="assignmentEmployee && !assignmentLoading && !assignmentError">
                                                    <div class="assignment-scroll"><table class="table"><thead><tr><th>Name</th><th>Effective Date</th><th>Employment Type</th><th>Position</th><th>Department / Assignment</th><th>Period Covered</th><th>PHIC Share Flag</th><th>Source</th></tr></thead><tbody>
                                                        <tr ng-repeat="item in visibleAssignments = (assignmentHistory | filter:assignmentSearch)"><td><strong>{{item.employee_name || '--'}}</strong><small>{{assignmentEmployee}}</small></td><td class="assignment-date">{{applicationDate(item.effective_date)}}</td><td>{{item.employment_type || '--'}}</td><td>{{item.position || '--'}}</td><td>{{item.department || '--'}}</td><td class="assignment-date">{{applicationDate(item.period_from)}}<span ng-if="applicationDate(item.period_from) !== applicationDate(item.period_to)"> &ndash; {{applicationDate(item.period_to)}}</span></td><td class="text-center">{{item.phic_share_flag == null ? '--' : item.phic_share_flag ? 'Yes' : 'No'}}</td><td><span class="assignment-source">{{item.source}}</span></td></tr>
                                                        <tr ng-if="!visibleAssignments.length"><td colspan="8" class="text-center">{{assignmentSearch ? 'No matching assignments.' : 'No assignment history found.'}}</td></tr>
                                                    </tbody></table></div>
                                                    <p class="assignment-note">{{visibleAssignments.length}} record(s). Payroll periods use the master record dates. Assignment periods start on the effective date and end before the next assignment or payroll record, capped by the payroll period end. PHIC Share Flag uses the assignment phic_flag value. A dash means no value is recorded.</p>
                                                </div>
