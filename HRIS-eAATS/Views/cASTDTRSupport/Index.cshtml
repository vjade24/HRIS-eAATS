    <div class="panel-body">
        <div class="application-heading"><i class="fa fa-line-chart" aria-hidden="true"></i><div><h4>Application Monitoring</h4><small>Leave applications, authorization slips and travel orders</small></div></div>
        <div class="application-info">
            <div><label>Employee</label><strong>{{applicationEmployeeName || 'Select an employee'}}</strong><span class="application-secondary" ng-if="applicationEmployee">Employee ID: {{applicationEmployee}}</span></div>
            <div><label>Period Covered</label><strong><i class="fa fa-calendar" aria-hidden="true"></i> {{applicationPeriod || 'Select a DTR period'}}</strong><span class="application-secondary">Based on the selected DTR month</span></div>
        </div>
        <div class="application-types" role="group" aria-label="Application type">
            <button type="button" class="application-card" ng-class="{'is-active': applicationType === 'leaves'}" ng-attr-aria-pressed="{{applicationType === 'leaves'}}" ng-click="selectApplicationType('leaves')"><i class="fa fa-calendar" aria-hidden="true"></i><span><strong>{{applications.leaves.length}}</strong><small>Leave Applications</small></span></button>
            <button type="button" class="application-card" ng-class="{'is-active': applicationType === 'slips'}" ng-attr-aria-pressed="{{applicationType === 'slips'}}" ng-click="selectApplicationType('slips')"><i class="fa fa-file-text-o" aria-hidden="true"></i><span><strong>{{applications.slips.length}}</strong><small>Authorization Slips</small></span></button>
            <button type="button" class="application-card travel-card" ng-class="{'is-active': applicationType === 'travels'}" ng-attr-aria-pressed="{{applicationType === 'travels'}}" ng-click="selectApplicationType('travels')"><i class="fa fa-plane" aria-hidden="true"></i><span><strong>{{applications.travels.length}}</strong><small>Travel Orders</small></span></button>
            <button type="button" class="application-card" ng-class="{'is-active': applicationType === 'transmittals'}" ng-attr-aria-pressed="{{applicationType === 'transmittals'}}" ng-click="selectApplicationType('transmittals')"><i class="fa fa-exchange" aria-hidden="true"></i><span><strong>{{trnsmt_list.length}}</strong><small>Transmittal</small></span></button>
            <button type="button" class="application-card" ng-class="{'is-active': applicationType === 'payroll'}" ng-attr-aria-pressed="{{applicationType === 'payroll'}}" ng-click="selectApplicationType('payroll')"><i class="fa fa-money" aria-hidden="true"></i><span><strong>{{trnsmt.length}}</strong><small>Payroll Created</small></span></button>
        </div>
        <p class="m-t-sm application-note">Applications covering the selected DTR month. Date details below show entries overlapping this period. Leave totals refer to the entire application.</p>
        <div ng-if="!applicationEmployee" class="alert alert-info">Select an employee to view applications.</div>
        <div ng-if="applicationLoading" class="alert alert-info" role="status">Loading applications...</div>
        <div ng-if="applicationError" class="alert alert-danger" role="alert">{{applicationError}} <button type="button" class="btn btn-default btn-xs" ng-click="loadApplications()">Retry</button></div>
        <div class="application-results" ng-if="applicationEmployee && !applicationLoading && !applicationError">
            <div class="application-toolbar"><div><h4>{{applicationType === 'leaves' ? 'Leave Applications' : applicationType === 'slips' ? 'Authorization Slips' : applicationType === 'travels' ? 'Travel Orders' : applicationType === 'transmittals' ? 'Transmittal' : 'Payroll Created'}} <span class="application-pill">{{applicationRecordCount()}}</span></h4><small>Applications within the selected period</small></div><div class="application-search"><label for="application-search">Search records</label><input id="application-search" class="form-control" type="search" ng-model="applicationSearch" placeholder="Number, status, purpose or details"></div></div>
            <div class="application-scroll" ng-if="applicationType === 'transmittals'">
                <table class="table"><thead><tr><th>Transmittal No.</th><th>Period</th><th>Purpose</th><th>Status</th><th>Created By</th><th>Date Created</th></tr></thead><tbody>
                    <tr ng-repeat="item in visibleTransmittals = (trnsmt_list | filter:applicationSearch)"><td class="application-number">{{item.transmittal_nbr}}</td><td>{{item.view_type_descr || '--'}}</td><td>{{item.transmittal_type_descr || '--'}}</td><td><span class="application-pill" ng-class="applicationStatusClass(item.approval_status)">{{item.approval_status_descr || '--'}}</span></td><td>{{item.created_name || item.created_by || '--'}}</td><td>{{item.created_dttm || '--'}}</td></tr>
                    <tr ng-if="!visibleTransmittals.length"><td colspan="6" class="application-empty">{{applicationSearch ? 'No matching transmittals.' : 'No transmittals for this period.'}}</td></tr>
                </tbody></table>
            </div>
            <div class="application-scroll" ng-if="applicationType === 'payroll'">
                <table class="table"><thead><tr><th>DTR Order No.</th><th>1st Quincena Created By</th><th>Date Created</th><th>2nd Quincena Created By</th><th>Date Created</th><th>Remarks</th></tr></thead><tbody>
                    <tr ng-repeat="item in visiblePayroll = (trnsmt | filter:applicationSearch)"><td class="application-number">{{item.dtr_order_no || '--'}}</td><td>{{item.frst_employee_name || item.frst_qcna_posted_by || '--'}}</td><td>{{item.frst_qcna_posted_by ? item.frst_qcna_posted_ddtm : '--'}}</td><td>{{item.sec_employee_name || item.sec_qcna_posted_by || '--'}}</td><td>{{item.sec_qcna_posted_by ? item.sec_qcna_posted_ddtm : '--'}}</td><td>{{item.remarks || '--'}}</td></tr>
                    <tr ng-if="!visiblePayroll.length"><td colspan="6" class="application-empty">{{applicationSearch ? 'No matching payroll records.' : 'No payroll creation records for this period.'}}</td></tr>
                </tbody></table>
            </div>
            <div class="application-scroll" ng-if="applicationType === 'leaves' || applicationType === 'travels'">
                <table class="table">
                    <thead><tr><th>Application</th><th>Filed</th><th>Covered Dates</th><th>{{applicationType === 'leaves' ? 'Leave Type / Total Days' : applicationType === 'travels' ? 'Destination / Purpose' : 'Remarks'}}</th><th>Status</th><th>Details</th></tr></thead>
                    <tbody>
                        <tr ng-repeat="app in filteredApplications = (applications[applicationType] | filter:applicationSearch)" ng-class="{'info': selectedApplication === app}">
                            <td><strong class="application-number">{{app.number}}</strong><span class="application-secondary">{{applicationEmployee}}</span></td><td>{{applicationDate(app.filed)}}</td><td><div ng-repeat="date in app.dates">{{applicationDate(date.date || date.from)}}<span ng-if="date.to"> - {{applicationDate(date.to)}}</span></div></td>
                            <td><span ng-if="applicationType === 'leaves'"><strong>{{app.type || '--'}}</strong><span class="application-secondary">{{app.days == null ? '--' : app.days}} day(s)</span></span><span ng-if="applicationType === 'travels'"><strong>{{app.destination || '--'}}</strong><span class="application-secondary">{{app.purpose || '--'}}</span></span><span ng-if="applicationType === 'slips'">{{app.remarks || '--'}}</span></td>
                            <td><span class="application-pill" ng-class="applicationStatusClass(app.status_code)">{{app.status || '--'}}</span></td><td><button type="button" class="btn btn-primary btn-xs" ng-click="viewApplication(app)">View Details</button></td>
                        </tr>
                        <tr ng-if="!filteredApplications.length"><td colspan="6" class="text-center">{{applicationSearch ? 'No matching applications.' : applicationType === 'leaves' ? 'No leave applications for this period.' : applicationType === 'slips' ? 'No authorization slips for this period.' : 'No travel orders for this period.'}}</td></tr>
                    </tbody>
                </table>
            </div>
            <div ng-if="applicationType === 'slips'">
                <div class="application-scroll">
                    <table class="application-slips">
                        <thead><tr><th rowspan="2">#</th><th rowspan="2">Application No.</th><th rowspan="2">DTR Date</th><th rowspan="2">Type</th><th rowspan="2">Reason</th><th colspan="2" class="application-am">AM</th><th colspan="2" class="application-pm">PM</th><th rowspan="2">Venue</th><th rowspan="2">Comment / Remarks</th><th rowspan="2">Status</th><th rowspan="2">Date Applied</th><th rowspan="2">Details</th></tr><tr><th class="application-am">In</th><th class="application-am">Out</th><th class="application-pm">In</th><th class="application-pm">Out</th></tr></thead>
                        <tbody><tr ng-repeat="row in visibleSlipRows = (applicationSlipRows | filter:applicationSearch)">
                            <td class="text-center">{{$index + 1}}</td><td class="application-number">{{row.number}}</td><td style="white-space:nowrap;">{{applicationDate(row.date.date)}}</td><td><span class="application-pill">{{row.date.type || '--'}}</span></td><td style="min-width:140px;">{{row.date.reason || '--'}}</td>
                            <td class="application-time">{{row.date.am_in || '--'}}</td><td class="application-time">{{row.date.am_out || '--'}}</td><td class="application-time">{{row.date.pm_in || '--'}}</td><td class="application-time">{{row.date.pm_out || '--'}}</td>
                            <td style="min-width:120px;">{{row.date.venue || '--'}}</td><td style="min-width:160px;">{{row.date.comments || '--'}}<div ng-if="row.remarks"><strong>Remarks:</strong> {{row.remarks}}</div><div ng-if="row.date.undertime != null"><strong>Undertime:</strong> {{row.date.undertime}}</div></td><td><span class="application-pill" ng-class="applicationStatusClass(row.status_code)">{{row.status || '--'}}</span><div ng-if="row.date.status && row.date.status !== row.status_code"><small>Entry: {{applicationStatus(row.date.status)}}</small></div></td><td style="white-space:nowrap;">{{applicationDate(row.filed)}}</td><td><button type="button" class="btn btn-primary btn-xs" ng-click="viewSlipApplication(row.number)"><i class="fa fa-eye" aria-hidden="true"></i> View Details</button></td>
                        </tr><tr ng-if="!visibleSlipRows.length"><td colspan="14" class="application-empty"><i class="fa fa-inbox"></i> {{applicationSearch ? 'No matching authorization slips.' : 'No authorization slip records found for this period.'}}</td></tr></tbody>
                    </table>
                    <div class="application-summary">TOTAL: {{visibleSlipRows.length}} record(s) &nbsp;|&nbsp; Approved: {{applicationSlipCount('F', visibleSlipRows)}} &nbsp;|&nbsp; Pending: {{applicationSlipCount('C', visibleSlipRows)}} &nbsp;|&nbsp; Rejected: {{applicationSlipCount('D', visibleSlipRows)}}</div>
                </div>
            </div>
        </div>
    </div>
</div>
