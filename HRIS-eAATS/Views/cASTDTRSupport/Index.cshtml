<section ng-app="ng_HRD_App" ng-controller="cASTDTRSupport_ctrl">
<div class="modal fade" id="application_details_modal" tabindex="-1" role="dialog" aria-labelledby="application-details-title"><div class="modal-dialog modal-lg" role="document"><div class="modal-content application-detail">
                <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button><h4 id="application-details-title"><strong>{{selectedApplication.number}}</strong> &mdash; {{selectedApplication.status}}</h4></div>
                <div class="modal-body" style="overflow-wrap:break-word;"><p><strong>Employee:</strong> {{applicationEmployeeName}} &nbsp; <strong>Period:</strong> {{applicationPeriod}}</p>
                    <p><strong>Date Filed:</strong> {{applicationDate(selectedApplication.filed)}}</p>
                    <div ng-if="applicationType === 'leaves'">
                        <p><strong>Leave Type:</strong> {{selectedApplication.type || '--'}} &nbsp; <strong>Total Days:</strong> {{selectedApplication.days == null ? '--' : selectedApplication.days}}</p>
                        <p><strong>Description:</strong> {{selectedApplication.description || '--'}}</p><p><strong>Remarks:</strong> {{selectedApplication.remarks || '--'}}</p><p><strong>Comments:</strong> {{selectedApplication.comments || '--'}}</p>
                        <div class="table-responsive"><table class="table table-bordered"><thead><tr><th>From</th><th>To</th><th>Days</th><th>Entry Status</th></tr></thead><tbody><tr ng-repeat="date in selectedApplication.dates"><td>{{applicationDate(date.from)}}</td><td>{{applicationDate(date.to)}}</td><td>{{date.days == null ? '--' : date.days}}</td><td>{{applicationStatus(date.status)}}</td></tr></tbody></table></div>
                    </div>
                    <div ng-if="applicationType === 'slips'">
                        <p><strong>Remarks:</strong> {{selectedApplication.remarks || '--'}}</p>
                        <div class="panel panel-default" ng-repeat="date in selectedApplication.dates"><div class="panel-heading"><strong>{{applicationDate(date.date)}}</strong> &mdash; {{date.type || '--'}} &mdash; {{applicationStatus(date.status)}}</div><div class="panel-body">
                            <div class="table-responsive"><table class="table table-bordered"><thead><tr><th>AM In</th><th>AM Out</th><th>PM In</th><th>PM Out</th></tr></thead><tbody><tr><td>{{date.am_in || '--'}}</td><td>{{date.am_out || '--'}}</td><td>{{date.pm_in || '--'}}</td><td>{{date.pm_out || '--'}}</td></tr></tbody></table></div>
                            <p><strong>Reason:</strong> {{date.reason || '--'}}</p><p><strong>Venue:</strong> {{date.venue || '--'}}</p><p><strong>Comments:</strong> {{date.comments || '--'}}</p><p><strong>Undertime (recorded value):</strong> {{date.undertime == null ? '--' : date.undertime}}</p>
                        </div></div>
                    </div>
                    <div ng-if="applicationType === 'travels'">
                        <p><strong>Travel Type:</strong> {{selectedApplication.type || '--'}}</p><p><strong>Destination:</strong> {{selectedApplication.destination || '--'}}</p><p><strong>Purpose:</strong> {{selectedApplication.purpose || '--'}}</p><p><strong>Details:</strong> {{selectedApplication.details || '--'}}</p><p><strong>Justification:</strong> {{selectedApplication.justification || '--'}}</p><p><strong>With Claims:</strong> {{selectedApplication.claims == null ? '--' : selectedApplication.claims ? 'Yes' : 'No'}}</p>
                        <div class="table-responsive"><table class="table table-bordered"><thead><tr><th>From</th><th>To</th><th>Start Time</th><th>End Time</th><th>Entry Status</th></tr></thead><tbody><tr ng-repeat="date in selectedApplication.dates"><td>{{applicationDate(date.from)}}</td><td>{{applicationDate(date.to)}}</td><td>{{date.start_time || '--'}}</td><td>{{date.end_time || '--'}}</td><td>{{applicationStatus(date.status)}}</td></tr></tbody></table></div>
                    </div>
                </div>
            <div class="modal-footer"><button type="button" class="btn btn-default btn-xs" data-dismiss="modal">Close</button></div></div></div></div>

